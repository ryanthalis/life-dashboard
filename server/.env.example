# Copy this file to .env and replace the placeholder password with the
# POSTGRES_PASSWORD value from ../docker/.env.

LIFE_DB_HOST=127.0.0.1
LIFE_DB_PORT=5432
LIFE_DB_NAME=life_dashboard
LIFE_DB_USER=life_dashboard_app
LIFE_DB_PASSWORD=replace_with_the_docker_postgres_password
LIFE_DB_SQL_ECHO=false
